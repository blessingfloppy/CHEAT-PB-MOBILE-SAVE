{
  "manifest_version": 3,
  "name": "CHEAT PB MOBILE SAVE",
  "version": "0.7.0",
  "description": "Skeleton dan Chams dari basis Brave Full untuk PBMobile",
  "permissions": ["debugger", "tabs", "storage"],
  "host_permissions": ["https://pbmobile.app/*", "https://*.pbmobile.app/*"],
  "background": { "service_worker": "worker.js" },
  "action": { "default_title": "PemburuHS Brave", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["https://pbmobile.app/*", "https://*.pbmobile.app/*"],
    "js": ["stealth.js", "preboot.js", "visuals.js"],
    "run_at": "document_start",
    "world": "MAIN"
  }]
}
